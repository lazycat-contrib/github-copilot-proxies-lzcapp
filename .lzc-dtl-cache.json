{
  "name": "Copilot后端代理",
  "package": "cloud.lazycat.app.copilot",
  "description": "GitHub Copilot插件服务端",
  "homepage": "https://gitee.com/ripperTs/github-copilot-proxies",
  "author": "ripperTs",
  "app_features": [
    "background_task",
    "public_path"
  ],
  "subdomain": "copilot",
  "version": "0.1.7",
  "public_paths": [
    "/"
  ],
  "iconPath": "icon.png",
  "composePath": "docker-compose.yml",
  "unsupported_platforms": [],
  "lastRouteType": "from_compose",
  "port_mappings": {
    "copilot-app_1188_1188": {
      "use": true,
      "type": "http",
      "path": "/",
      "targetPath": "/"
    },
    "copilot-app_443_443": {
      "use": false
    }
  },
  "image_registry.cn-hangzhou.aliyuncs.com_ripper_copilot-proxies_latest": {
    "originalImage": "registry.cn-hangzhou.aliyuncs.com/ripper/copilot-proxies:latest",
    "pushTarget": "none"
  },
  "copilot-app_volume_/app/logs_action": "emptyDir",
  "copilot-app_volume_/app/logs_location": "app_data"
}
